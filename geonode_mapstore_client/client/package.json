{
  "name": "geonode-mapstore-client",
  "version": "5.0.x",
  "description": "MapStore 2 bundles specific to geonode framework",
  "eslintConfig": {
    "extends": [
      "@mapstore/eslint-config-mapstore"
    ],
    "parserOptions": {
      "babelOptions": {
        "configFile": "./node_modules/mapstore/build/babel.config.js"
      }
    },
    "globals": {
      "__MAPSTORE_PROJECT_CONFIG__": false,
      "xit": false
    },
    "rules": {
      "no-unused-vars": [
        2,
        {
          "vars": "local",
          "args": "after-used",
          "ignoreRestSiblings": true,
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "scripts": {
    "compile": "mapstore-project compile && node postCompile",
    "compile:dev": "MAPSTORE_COMPILE_DEV=true mapstore-project compile && node postCompile",
    "start": "mapstore-project start",
    "test": "karma start karma.conf.single-run.js --colors",
    "test:upstream": "mapstore-project test",
    "test:watch": "mapstore-project test:watch",
    "coverage": "COVERAGE=1 karma start karma.conf.single-run.js --colors",
    "coverage:hydrata": "node -e \"const fs=require('fs');if(!fs.existsSync('coverage/lcov.info')){console.error('coverage/lcov.info not found — run \\\"npm run coverage\\\" first');process.exit(1);}const src=fs.readFileSync('coverage/lcov.info','utf8');const recs=src.split(/^end_of_record$/m);const keep=recs.filter(r=>/^SF:(.*\\/)?js\\//m.test(r)&&!/MapStore2\\//.test(r));if(keep.length===0){console.warn('WARN: 0 Hydrata records matched — lcov.info SF: paths may have changed shape');}fs.writeFileSync('coverage/lcov-hydrata.info',keep.join('end_of_record')+'end_of_record\\n');console.log('Wrote coverage/lcov-hydrata.info (records: '+keep.length+')');\"",
    "coverage:open": "xdg-open coverage/report-html/index.html",
    "lint": "eslint js/plugins/hydrata --ext .jsx,.js",
    "lint:fix": "eslint js/plugins/hydrata --ext .jsx,.js --fix",
    "docs": "jsdoc -r js/plugins js/utils/AppUtils.js ./README.md -d ../../docs -u ../../tutorials -t ./docs-template"
  },
  "author": "GeoSolutions",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@mapstore/project": "git+https://github.com/Hydrata/mapstore-project.git#geonode-5.0.x",
    "dotenv": "10.0.0",
    "jsdoc": "4.0.0"
  },
  "dependencies": {
    "@jsdoc/salty": "0.2.1",
    "@openreplay/tracker": "^18.0.13",
    "@openreplay/tracker-redux": "^4.0.1",
    "@rjsf/core": "^5.19.4",
    "@rjsf/utils": "^5.19.4",
    "@rjsf/validator-ajv8": "^5.19.4",
    "@tanstack/react-table": "^8.21.3",
    "ag-grid-community": "^35.1.0",
    "ag-grid-react": "^32.3.4",
    "mapstore": "file:MapStore2",
    "react-helmet": "6.1.0",
    "react-intl": "2.3.0",
    "react-router-dom": "4.1.1",
    "xlsx": "^0.18.5"
  },
  "mapstore": {
    "output": "dist",
    "publicPath": "/static/mapstore/dist/",
    "themePrefix": "msgapi",
    "cesiumBaseUrl": "/static/mapstore/dist/cesium",
    "apps": [
      "js/apps"
    ],
    "html": [
      ""
    ],
    "themes": [
      "themes/"
    ]
  }
}
